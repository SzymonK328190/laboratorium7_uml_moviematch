@startuml 01_context_diagram
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName "Inter"
skinparam defaultFontSize 12
skinparam roundcorner 12
skinparam nodesep 35
skinparam ranksep 65
skinparam padding 8

skinparam titleFontSize 18
skinparam titleFontColor #1E3A5F

skinparam actor {
  BackgroundColor #EAF2FA
  BorderColor #1E3A5F
  FontColor #0F172A
  FontStyle bold
}

skinparam rectangle {
  BorderColor #1E3A5F
  FontColor #0F172A
}

skinparam arrow {
  Color #334155
  FontColor #1E293B
  FontSize 11
}

title Model Kontekstowy (Context Diagram) — System MovieMatch (Aplikacja webowa, MVP v1.0)

left to right direction

' ==================== AKTORZY (POZA GRANICĄ SYSTEMU) ====================
rectangle "Aktorzy systemu (poza granicą)" as ActorsPkg #F8FAFC;line:64748B;line.dashed {
  actor "Gość\n(Niezarejestrowany)" as Guest
  actor "Użytkownik\n(Zarejestrowany)" as User
  actor "Uczestnik\nsesji grupowej" as Participant
  actor "Administrator\ngrupy" as Admin

  Participant -u-|> User
  Admin -u-|> User
}

' ==================== GRANICA SYSTEMU ====================
rectangle "«Granica Systemu — Aplikacja webowa (mobile-first) + Backend PHP / ML»\n\n<b>System MovieMatch</b>\n\n• Rejestracja i logowanie, hashowanie haseł (FR-02, FR-03)\n• Początkowa ankieta preferencji gatunkowych (FR-01)\n• Katalog filmów, wyszukiwanie, ocenianie 1.0–10.0 i ranking (FR-04, FR-08)\n• Silnik rekomendacji ML — wektory filmów i preferencji (FR-10, FR-11)\n• Tworzenie grup (tymczasowych i stałych), dołączanie linkiem, zarządzanie (FR-06, FR-07, FR-13)\n• Synchronizacja widoku propozycji w sesji grupowej (US-5 AC2)" as MovieMatch #E6F4EA;line:2E7D32;line.bold

' ==================== SYSTEMY ZEWNĘTRZNE I OTOCZENIE ====================
rectangle "Otoczenie i systemy zewnętrzne (poza granicą)" as ExtPkg #FFFDF7;line:C67C00;line.dashed {
  rectangle "«Środowisko klienckie»\n<b>Przeglądarka WWW</b>\n(Smartfon / Tablet / Desktop)\nResponsywny UI (mobile-first)\ni komunikacja HTTPS" as Browser #FFF4E0;line:C67C00

  rectangle "«Kanał zewnętrzny»\n<b>Zewnętrzny komunikator</b>\n(np. Messenger, SMS, WhatsApp)\nRęczne przekazanie linku zaproszenia\nprzez użytkownika (poza aplikacją)" as Messenger #FFF4E0;line:C67C00

  rectangle "«System zewnętrzny»\n<b>TMDB (The Movie Database)</b>\nKatalog filmów (~8 244), gatunki,\nobsada, słowa kluczowe, plakaty" as MovieDB #FFF4E0;line:C67C00

  rectangle "«System zewnętrzny»\n<b>System kopii zapasowych</b>\n(Backup Storage)\nZewnętrzny magazyn archiwalny" as BackupSvc #FFF4E0;line:C67C00
}

' ==================== RELACJE AKTORZY <-> SYSTEM ====================
Guest --> MovieMatch : Przeglądanie/wyszukiwanie katalogu;\nrejestracja (e-mail, nazwa użytkownika, hasło)\n← katalog lub przekierowanie do logowania [FR-02, FR-04]

User --> MovieMatch : Logowanie, ankieta, oceny (1.0–10.0),\nranking, dobieranie ind., dołączanie linkiem\n← rekomendacje i profil\n[FR-01, FR-03, FR-04, FR-06, FR-07, FR-08, FR-11]

Participant --> MovieMatch : Uruchomienie dobierania grupowego\n← zsynchronizowana propozycja filmu [FR-10]

Admin --> MovieMatch : Tworzenie grupy (tymcz./stała), kopiowanie linku,\nusuwanie członków, zmiana nazwy/usunięcie\n← status i skład grupy [FR-07, FR-13]

' ==================== RELACJE SYSTEM <-> OTOCZENIE ====================
MovieMatch <--> Browser : Interfejs webowy responsywny (mobile-first, HTTPS)\n(≤ 3 s, do 10 jednoczesnych użytkowników)\n[NFR Kompatybilność, Prywatność, Obciążenie]

MovieMatch ..> Messenger : Wygenerowany link URL zaproszenia\nprzekazywany przez użytkownika\n(kopiuj / udostępnij) [US-4 AC1]

MovieMatch <-- MovieDB : Synchronizacja katalogu filmów, metadanych\ni plakatów do zasilania wektorów ML\n[NFR Algorytm dobierania filmów]

MovieMatch --> BackupSvc : Automatyczna pełna kopia zapasowa\nbazy danych (oceny, profile, grupy)\nco najmniej 1× na dobę [NFR Niezawodność]

@enduml
